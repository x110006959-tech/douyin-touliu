{
  "name": "douyin-local-life-subject-diagnosis",
  "version": "0.2.2",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @douyin-local-life/api --filter @douyin-local-life/web dev",
    "dev:web": "corepack pnpm --filter @douyin-local-life/web dev",
    "dev:api": "corepack pnpm --filter @douyin-local-life/api dev",
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "architecture:check": "node tools/architecture-check.mjs",
    "format:check": "node tools/source-hygiene-check.mjs",
    "lint": "corepack pnpm format:check && corepack pnpm architecture:check",
    "extension:build": "corepack pnpm --filter @douyin-local-life/extension build",
    "db:push": "corepack pnpm exec prisma db push",
    "prisma:generate": "corepack pnpm exec prisma generate",
    "retention:dry-run": "corepack pnpm --filter @douyin-local-life/api retention:dry-run",
    "retention:run": "corepack pnpm --filter @douyin-local-life/api retention:run",
    "backup:run": "sh tools/backup-postgres.sh",
    "restore:verify": "sh tools/verify-postgres-backup.sh",
    "backup:postgres": "sh tools/backup-postgres.sh",
    "backup:verify": "sh tools/verify-postgres-backup.sh",
    "version:check": "node tools/version-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "pnpm": "11.9.0",
    "prisma": "^6.1.0"
  }
}
