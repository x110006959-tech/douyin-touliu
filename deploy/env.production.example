# Copy this file to .env on the server, then replace every placeholder.

# PostgreSQL credentials. Use a long random password and URL-safe characters only.
POSTGRES_USER="pxxis"
POSTGRES_PASSWORD="replace-with-a-long-random-url-safe-password"
POSTGRES_DB="pxxis"
COMPOSE_DATABASE_URL="postgresql://pxxis:replace-with-a-long-random-url-safe-password@postgres:5432/pxxis?schema=public"

# Must be at least 32 random characters. Keep this value stable after first login.
SECURITY_SECRET="replace-with-at-least-32-random-characters"

# Public origins used by the API and baked into the Web image.
WEB_ORIGIN="https://www.pxxis.cn"
NEXT_PUBLIC_API_URL="https://api.pxxis.cn"
API_BIND_PORT="4000"
WEB_BIND_PORT="3000"
TRUST_PROXY_HOPS="1"
SESSION_COOKIE_SECURE="true"

# Reverse proxy and HTTPS.
WEB_DOMAIN="www.pxxis.cn"
API_DOMAIN="api.pxxis.cn"
CADDY_ACME_EMAIL="replace-with-your-email@example.com"

# Leave false until a real diagnosis has been verified.
AI_DIAGNOSIS_ENABLED="false"
LIVE_SCREEN_INTERNAL_API_ENABLED="false"
LOCAL_PROMOTION_INTERNAL_API_ENABLED="false"

# SMTP is required for email verification. Use a real TLS-capable mailbox.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="replace-with-smtp-user"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="PXXIS <no-reply@pxxis.cn>"

# Optional build metadata.
GIT_SHA=""
BUILD_TIME=""
SCHEMA_VERSION="20260731_v035_ai_skill_diagnosis"
