DATABASE_URL="postgresql://diagnosis:diagnosis@localhost:5432/douyin_subject_diagnosis?schema=public"
COMPOSE_DATABASE_URL="postgresql://diagnosis:replace-with-url-safe-password@postgres:5432/douyin_subject_diagnosis?schema=public"
POSTGRES_USER="diagnosis"
POSTGRES_PASSWORD="replace-with-url-safe-password"
POSTGRES_DB="douyin_subject_diagnosis"
JWT_SECRET="replace-with-at-least-32-random-characters"
API_PORT="4000"
API_BIND_PORT="4000"
WEB_BIND_PORT="3000"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
TRUST_PROXY_HOPS="0"
EXTENSION_ORIGINS="chrome-extension://replace-with-your-extension-id"

# Production domain example:
# WEB_ORIGIN="https://www.pxxis.cn"
# NEXT_PUBLIC_API_URL="https://api.pxxis.cn"
