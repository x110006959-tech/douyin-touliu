generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum PendingRegistrationStatus {
  PENDING
  VERIFIED
  EXPIRED
}

enum BusinessType {
  DOUYIN_LOCAL_LIFE
}

enum SubjectType {
  SUBJECT_PENDING
  MERCHANT_OFFICIAL
  PROFESSIONAL
  EXTERNAL_CREATOR
  CREATOR_MATRIX
  SERVICE_PROVIDER
  PLATFORM_EVENT
  BRAND_REGION_MATRIX
}

enum OperatorType {
  OPERATOR_PENDING
  MERCHANT_SELF
  SERVICE_PROVIDER_LIVE
  SERVICE_PROVIDER_OPERATION
  CREATOR_SELF
  AGENCY_LEADER
  PLATFORM_OPERATION
  BRAND_REGION
}

enum CooperationType {
  COOPERATION_PENDING
  NONE
  PROFESSIONAL_BINDING
  CREATOR_COOPERATION
  SERVICE_PROVIDER_CONTRACT
  PLATFORM_INVITATION
  BRAND_MATRIX
}

enum ControlLevel {
  PENDING
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum AccountProfileStatus {
  ACTIVE
  ARCHIVED
}

enum AccountIdentityStatus {
  PENDING_ID
  VERIFIED
}

enum AccountMatchStatus {
  MATCHED
  MISMATCHED
  UNVERIFIED
}

enum CollectionRouteSourceStatus {
  PENDING
  CAPTURED
  FAILED
}

enum RouteVerificationStatus {
  VERIFIED
  MANUAL_PENDING
}

enum CollectionTaskStatus {
  PENDING
  COLLECTING
  REVIEWING
  UPLOADED
  PROCESSING
  ANALYZED
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActionType {
  OBSERVE
  INCREASE_BUDGET
  DECREASE_BUDGET
  KEEP_BUDGET
  FINE_TUNE_TARGETING
  DECREASE_BID
  PAUSE_TASK
  ADJUST_ROI_TARGET
  CHECK_LIVE_ROOM
  CHECK_CREATIVE
  CHECK_AUDIENCE
  VERIFY_ACTIVITY
  APPLY_ACTIVITY
  OPTIMIZE_SCRIPT
  REPAIR_REPUTATION
  STRENGTHEN_SHELF
  CHECK_INVENTORY_BOOKING
  OPTIMIZE_POI_SEARCH
  REPLACE_CREATOR
  UNIFY_CREATOR_SCRIPT
  ADJUST_SERVICE_PROVIDER_SOP
  RENEGOTIATE_SERVICE_FEE
  REUSE_MATERIAL
  ALLOCATE_HIGH_VERIFY_STORES
  CALIBRATE_SUBJECT
  REQUEST_MANUAL_REVIEW
}

enum ActionProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OBSERVING
  MANUAL_EXECUTED
  EXPIRED
  SUPERSEDED
}

enum CollectionRunStatus {
  ACTIVE
  COMPLETED
  STOPPED
  DEGRADED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  APPROVED
  REJECTED
  OBSERVE
}

enum ExecutionMode {
  MANUAL
}

enum ExecutionStatus {
  PENDING
  MANUAL_EXECUTED
  FAILED
}

enum OutcomeObservationWindow {
  THIRTY_MINUTES
  TWO_HOURS
  ONE_DAY
  CUSTOM
}

enum ActionOutcomeResult {
  IMPROVED
  WORSENED
  NO_CHANGE
  UNCLEAR
}

enum MetricDriftStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum AiCircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

enum MetricSource {
  XHR_JSON
  TABLE
  DOM_TEXT
  SCREENSHOT
  MANUAL_INPUT
  UNKNOWN
}

enum MetricReviewStatus {
  PENDING
  CONFIRMED
  MODIFIED
  IGNORED
}

enum ExtensionCredentialScope {
  COLLECT
  READ_DIAGNOSIS
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  emailVerifiedAt DateTime         @default(now())
  passwordHash    String
  name            String?
  role            UserRole         @default(MEMBER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspaces      Workspace[]
  collectionTasks CollectionTask[]
  auditLogs       AuditLog[]
  approvalRecords ApprovalRecord[]
  executionLogs   ExecutionLog[]
  reviewedMetrics ReviewedMetric[]
  actionOutcomes  ActionOutcome[]
  metricAliasesCreated MetricAliasOverride[] @relation("MetricAliasCreatedBy")
  metricDriftsResolved MetricDriftEvent[] @relation("MetricDriftResolvedBy")
  snapshotAccountConfirmations DataSnapshot[] @relation("SnapshotAccountConfirmedBy")
  snapshotRouteConfirmations   DataSnapshot[] @relation("SnapshotRouteConfirmedBy")
  extensionPairingCodes ExtensionPairingCode[]
  extensionCredentials ExtensionCredential[]
  sessions        UserSession[]
}

model PendingRegistration {
  id           String                    @id @default(cuid())
  email        String                    @unique
  passwordHash String
  name         String?
  status       PendingRegistrationStatus @default(PENDING)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  verificationTokens EmailVerificationToken[]

  @@index([status, updatedAt])
}

model EmailVerificationToken {
  id                    String              @id @default(cuid())
  pendingRegistrationId String
  tokenHash             String              @unique
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime            @default(now())
  pendingRegistration   PendingRegistration @relation(fields: [pendingRegistrationId], references: [id], onDelete: Cascade)

  @@index([pendingRegistrationId, expiresAt])
  @@index([expiresAt])
}

model UserSession {
  id                String   @id @default(cuid())
  userId            String
  tokenHash         String   @unique
  csrfTokenHash     String
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  lastSeenAt        DateTime @default(now())
  revokedAt         DateTime?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model RateLimitBucket {
  keyHash         String   @id
  windowStartedAt DateTime
  expiresAt       DateTime
  count           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]
  accountProfiles AccountProfile[]
  auditLogs AuditLog[]
  metricAliasOverrides MetricAliasOverride[]
  extensionPairingCodes ExtensionPairingCode[]
  extensionCredentials ExtensionCredential[]

  @@index([ownerId])
}

model AccountProfile {
  id                 String                @id @default(cuid())
  workspaceId        String
  platform           String                @default("DOUYIN_LOCAL_LIFE")
  platformAccountId  String?
  identityKey        String
  accountName        String
  normalizedName     String
  merchantName       String?
  storeName          String?
  memo               String?
  identityStatus     AccountIdentityStatus @default(PENDING_ID)
  status             AccountProfileStatus  @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects           Project[]
  extensionPairingCodes ExtensionPairingCode[]
  extensionCredentials ExtensionCredential[]

  @@unique([workspaceId, platform, identityKey])
  @@index([workspaceId, status])
  @@index([platformAccountId])
  @@index([normalizedName])
}

model ExtensionPairingCode {
  id               String         @id @default(cuid())
  workspaceId      String
  accountProfileId String
  collectionTaskId String?
  userId           String
  codeHash         String         @unique
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime       @default(now())
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile   AccountProfile @relation(fields: [accountProfileId], references: [id], onDelete: Cascade)
  collectionTask   CollectionTask? @relation(fields: [collectionTaskId], references: [id], onDelete: SetNull)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountProfileId, expiresAt])
  @@index([collectionTaskId, expiresAt])
  @@index([userId, createdAt])
}

model ExtensionCredential {
  id               String                     @id @default(cuid())
  workspaceId      String
  accountProfileId String
  userId           String
  tokenHash        String                     @unique
  label            String?
  scopes           ExtensionCredentialScope[]
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile   AccountProfile             @relation(fields: [accountProfileId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountProfileId, revokedAt, expiresAt])
  @@index([userId, createdAt])
}

model Project {
  id                  String           @id @default(cuid())
  workspaceId         String
  accountProfileId    String
  name                String
  businessType        BusinessType     @default(DOUYIN_LOCAL_LIFE)
  subjectType         SubjectType      @default(SUBJECT_PENDING)
  operatorType        OperatorType     @default(OPERATOR_PENDING)
  cooperationType     CooperationType  @default(COOPERATION_PENDING)
  controlLevel        ControlLevel     @default(PENDING)
  subjectConfidence   Float            @default(0)
  serviceProviderName String?
  serviceMode         String?
  serviceFee          Float?
  status              ProjectStatus    @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  workspace           Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile      AccountProfile   @relation(fields: [accountProfileId], references: [id], onDelete: Restrict)
  tasks               CollectionTask[]
  auditLogs           AuditLog[]
  decisionRuns        DecisionRun[]
  actionProposals     ActionProposal[]
  executionLogs       ExecutionLog[]
  actionOutcomes      ActionOutcome[]
  metricDriftEvents   MetricDriftEvent[]
  actionProposalGates ActionProposalGate[]
  actionProposalQuotas ActionProposalQuota[]

  @@index([workspaceId])
  @@index([accountProfileId, status])
  @@index([subjectType, operatorType])
}

model CollectionTask {
  id              String               @id @default(cuid())
  projectId       String
  userId          String
  idempotencyKey  String?
  status          CollectionTaskStatus @default(PENDING)
  sourceUrl       String?
  pageTitle       String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots       DataSnapshot[]
  analyses        AiAnalysisTask[]
  auditLogs       AuditLog[]
  decisionRuns    DecisionRun[]
  actionProposals ActionProposal[]
  executionLogs   ExecutionLog[]
  reviewedMetrics ReviewedMetric[]
  actionOutcomes  ActionOutcome[]
  collectionRuns  CollectionRun[]
  metricDriftEvents MetricDriftEvent[]
  actionProposalGates ActionProposalGate[]
  routeSources    CollectionRouteSource[]
  extensionPairingCodes ExtensionPairingCode[]

  @@unique([projectId, idempotencyKey])
  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model CollectionRouteSource {
  id          String                      @id @default(cuid())
  taskId      String
  routeKey    String
  label       String
  sourceUrl   String?
  required    Boolean                     @default(false)
  status      CollectionRouteSourceStatus @default(PENDING)
  lastCapturedAt DateTime?
  lastError   String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  task        CollectionTask              @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, routeKey])
  @@index([taskId, status])
}

model CollectionRun {
  id                 String                     @id @default(cuid())
  taskId             String
  status             CollectionRunStatus        @default(ACTIVE)
  requiredRoutesJson Json
  startedAt          DateTime                   @default(now())
  lastSnapshotAt     DateTime?
  completedAt        DateTime?
  stoppedAt          DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  task               CollectionTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snapshots          DataSnapshot[]
  routeHealth        CollectionRouteHeartbeat[]

  @@index([taskId, createdAt])
  @@index([status])
}

model CollectionRouteHeartbeat {
  id                  String        @id @default(cuid())
  collectionRunId     String
  routeKey            String
  consecutiveFailures Int           @default(0)
  lastAttemptAt       DateTime      @default(now())
  lastSuccessAt       DateTime?
  lastError           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  collectionRun       CollectionRun @relation(fields: [collectionRunId], references: [id], onDelete: Cascade)

  @@unique([collectionRunId, routeKey])
  @@index([collectionRunId, consecutiveFailures])
}

model DataSnapshot {
  id                 String             @id @default(cuid())
  taskId             String
  idempotencyKey     String?
  pageType           String?
  rawDomText         String?
  rawNetworkJson     Json?
  rawTableData       Json?
  visibleMetricsJson Json?
  captureMetaJson    Json?
  screenshotUrl      String?
  localCollectedAt   DateTime
  collectionRunId    String?
  routeKey           String?
  routeVerificationStatus RouteVerificationStatus @default(VERIFIED)
  routeConfirmedById String?
  routeConfirmedAt   DateTime?
  accountMatchStatus AccountMatchStatus @default(UNVERIFIED)
  detectedAccountId  String?
  detectedAccountName String?
  accountMatchEvidence Json?
  accountConfirmedById String?
  accountConfirmedAt DateTime?
  uploadedAt         DateTime           @default(now())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  task               CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  normalizedMetrics  NormalizedMetric[]
  reviewedMetrics    ReviewedMetric[]
  collectionRun      CollectionRun?     @relation(fields: [collectionRunId], references: [id], onDelete: SetNull)
  metricDriftEvents  MetricDriftEvent[]
  accountConfirmedBy User? @relation("SnapshotAccountConfirmedBy", fields: [accountConfirmedById], references: [id], onDelete: SetNull)
  routeConfirmedBy   User? @relation("SnapshotRouteConfirmedBy", fields: [routeConfirmedById], references: [id], onDelete: SetNull)

  @@unique([taskId, idempotencyKey])
  @@index([taskId])
  @@index([collectionRunId, routeKey])
  @@index([taskId, accountMatchStatus])
  @@index([taskId, routeVerificationStatus])
}

model NormalizedMetric {
  id             String          @id @default(cuid())
  snapshotId     String
  metricKey      String
  metricName     String
  metricValue    String
  metricUnit     String?
  metricSource   String
  confidence     Float           @default(0.5)
  rawEvidence    Json?
  createdAt      DateTime        @default(now())
  snapshot       DataSnapshot    @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reviewedMetric ReviewedMetric?

  @@index([snapshotId])
  @@index([metricKey])
}

model ReviewedMetric {
  id                 String             @id @default(cuid())
  taskId             String
  snapshotId         String?
  normalizedMetricId String?            @unique
  metricKey          String
  metricName         String
  originalValue      String?
  reviewedValue      String?
  metricUnit         String?
  metricSource       MetricSource       @default(UNKNOWN)
  confidence         Float              @default(0.5)
  rawEvidence        Json?
  pageType           String?
  scope              String?
  timeRange          String?
  reviewStatus       MetricReviewStatus @default(PENDING)
  reviewerId         String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  task               CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snapshot           DataSnapshot?      @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  normalizedMetric   NormalizedMetric?  @relation(fields: [normalizedMetricId], references: [id], onDelete: SetNull)
  reviewer           User?              @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([snapshotId])
  @@index([metricKey])
  @@index([metricSource])
  @@index([reviewStatus])
  @@index([reviewerId])
}

model AiAnalysisTask {
  id               String         @id @default(cuid())
  collectionTaskId String
  provider         String
  model            String
  promptVersion    String
  status           AnalysisStatus @default(PENDING)
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  collectionTask   CollectionTask @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  decisionRuns     DecisionRun[]

  @@index([collectionTaskId])
  @@index([status])
}

model LegacyRecommendation {
  id                   String    @id @default(cuid())
  aiAnalysisTaskId     String
  summary              String
  riskLevel            RiskLevel
  problemsJson         Json?
  suggestionsJson      Json?
  manualCheckItemsJson Json?
  confidence           Float
  createdAt            DateTime  @default(now())

  @@index([aiAnalysisTaskId])
  @@index([createdAt])
  @@map("Recommendation")
  @@ignore
}

model DecisionRun {
  id                   String           @id @default(cuid())
  projectId            String
  collectionTaskId     String
  idempotencyKey       String?
  aiAnalysisTaskId     String?
  engineVersion        String
  ruleVersion          String
  strategyVersion      String           @default("local-life-rules-v0.1.0")
  evidenceFingerprint  String?
  inputJson            Json?
  riskLevel            RiskLevel
  confidence           Float
  diagnosis            String
  ruleResultJson       Json
  aiResultJson         Json?
  finalResultJson      Json
  manualCheckItemsJson Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask       CollectionTask   @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  aiAnalysisTask       AiAnalysisTask?  @relation(fields: [aiAnalysisTaskId], references: [id], onDelete: SetNull)
  actionProposals      ActionProposal[]

  @@unique([collectionTaskId, idempotencyKey])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([aiAnalysisTaskId])
  @@index([createdAt])
}

model ActionProposal {
  id               String               @id @default(cuid())
  decisionRunId    String
  projectId        String
  collectionTaskId String
  actionType       ActionType
  title            String
  summary          String?
  reason           String
  expectedImpact   String?
  riskLevel        RiskLevel
  confidence       Float
  requiresApproval Boolean              @default(true)
  blockedReason    String?
  status           ActionProposalStatus @default(PENDING_APPROVAL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  approvedAt       DateTime?
  rejectedAt       DateTime?
  observedAt       DateTime?
  manualExecutedAt DateTime?
  expiresAt        DateTime?
  dedupeKey        String?
  supersededAt     DateTime?
  decisionRun      DecisionRun          @relation(fields: [decisionRunId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask   CollectionTask       @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  approvalRecords  ApprovalRecord[]
  executionLogs    ExecutionLog[]
  outcomes         ActionOutcome[]

  @@index([decisionRunId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([status])
  @@index([actionType])
  @@index([projectId, dedupeKey, createdAt])
  @@index([expiresAt])
}

model ApprovalRecord {
  id               String           @id @default(cuid())
  actionProposalId String
  userId           String
  decision         ApprovalDecision
  comment          String?
  createdAt        DateTime         @default(now())
  actionProposal   ActionProposal   @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionProposalId])
  @@index([userId])
  @@index([decision])
}

model ExecutionLog {
  id               String          @id @default(cuid())
  actionProposalId String
  projectId        String?
  collectionTaskId String?
  userId           String
  mode             ExecutionMode   @default(MANUAL)
  status           ExecutionStatus @default(MANUAL_EXECUTED)
  note             String?
  createdAt        DateTime        @default(now())
  actionProposal   ActionProposal  @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  collectionTask   CollectionTask? @relation(fields: [collectionTaskId], references: [id], onDelete: SetNull)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionProposalId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([userId])
  @@index([status])
}

model ActionOutcome {
  id                String                   @id @default(cuid())
  actionProposalId  String
  idempotencyKey    String?
  projectId         String
  collectionTaskId  String
  userId            String
  observationWindow OutcomeObservationWindow
  customWindow      String?
  beforeMetricsJson Json?
  afterMetricsJson  Json?
  result            ActionOutcomeResult
  note              String?
  conclusion        String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  actionProposal    ActionProposal           @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask    CollectionTask           @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([actionProposalId, idempotencyKey])
  @@index([actionProposalId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([userId])
  @@index([result])
  @@index([createdAt])
}

model MetricAliasOverride {
  id              String    @id @default(cuid())
  workspaceId     String
  aliasNormalized String
  pageType        String    @default("ANY")
  metricKey       String
  active          Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("MetricAliasCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, aliasNormalized, pageType])
  @@index([workspaceId, active])
  @@index([metricKey])
}

model MetricDriftEvent {
  id              String            @id @default(cuid())
  dedupeKey       String            @unique
  projectId       String
  collectionTaskId String
  snapshotId      String?
  rawField        String
  aliasNormalized String
  pageType        String
  reason          String
  candidateKeysJson Json?
  status          MetricDriftStatus @default(OPEN)
  resolvedMetricKey String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask  CollectionTask    @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  snapshot        DataSnapshot?     @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  resolvedBy      User?             @relation("MetricDriftResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([projectId, status, createdAt])
  @@index([collectionTaskId, status])
  @@index([aliasNormalized])
}

model ActionProposalGate {
  id               String         @id @default(cuid())
  projectId        String
  collectionTaskId String
  actionType       ActionType
  nextAllowedAt    DateTime
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask   CollectionTask @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)

  @@unique([projectId, collectionTaskId, actionType])
  @@index([nextAllowedAt])
}

model ActionProposalQuota {
  id          String   @id @default(cuid())
  projectId   String
  windowStart DateTime
  strongCount Int      @default(0)
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, windowStart])
  @@index([windowStart])
}

model AiProviderCircuit {
  id                  String         @id @default(cuid())
  provider            String
  model               String
  state               AiCircuitState @default(CLOSED)
  consecutiveFailures Int            @default(0)
  backoffLevel        Int            @default(0)
  openedUntil         DateTime?
  halfOpenLeaseUntil  DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([provider, model])
  @@index([state, openedUntil])
}

model LegacyStrategyRule {
  id            String       @id @default(cuid())
  projectId     String?
  name          String
  description   String?
  subjectType   SubjectType?
  actionType    ActionType?
  enabled       Boolean      @default(true)
  priority      Int          @default(100)
  conditionJson Json
  effectJson    Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([projectId])
  @@index([subjectType])
  @@index([actionType])
  @@index([enabled])
  @@map("StrategyRule")
  @@ignore
}

model AuditLog {
  id          String          @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  taskId      String?
  action      String
  detailJson  Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        CollectionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([action])
}
