generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum BusinessType {
  DOUYIN_LOCAL_LIFE
}

enum SubjectType {
  SUBJECT_PENDING
  MERCHANT_OFFICIAL
  PROFESSIONAL
  EXTERNAL_CREATOR
  CREATOR_MATRIX
  SERVICE_PROVIDER
  PLATFORM_EVENT
  BRAND_REGION_MATRIX
}

enum OperatorType {
  OPERATOR_PENDING
  MERCHANT_SELF
  SERVICE_PROVIDER_LIVE
  SERVICE_PROVIDER_OPERATION
  CREATOR_SELF
  AGENCY_LEADER
  PLATFORM_OPERATION
  BRAND_REGION
}

enum CooperationType {
  COOPERATION_PENDING
  NONE
  PROFESSIONAL_BINDING
  CREATOR_COOPERATION
  SERVICE_PROVIDER_CONTRACT
  PLATFORM_INVITATION
  BRAND_MATRIX
}

enum ControlLevel {
  PENDING
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionTaskStatus {
  PENDING
  COLLECTING
  REVIEWING
  UPLOADED
  PROCESSING
  ANALYZED
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  role            UserRole         @default(MEMBER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspaces      Workspace[]
  collectionTasks CollectionTask[]
  auditLogs       AuditLog[]
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]
  auditLogs AuditLog[]

  @@index([ownerId])
}

model Project {
  id                  String          @id @default(cuid())
  workspaceId         String
  name                String
  businessType        BusinessType    @default(DOUYIN_LOCAL_LIFE)
  subjectType         SubjectType     @default(SUBJECT_PENDING)
  operatorType        OperatorType    @default(OPERATOR_PENDING)
  cooperationType     CooperationType @default(COOPERATION_PENDING)
  controlLevel        ControlLevel    @default(PENDING)
  subjectConfidence   Float           @default(0)
  serviceProviderName String?
  serviceMode         String?
  serviceFee          Float?
  status              ProjectStatus   @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks               CollectionTask[]
  auditLogs           AuditLog[]

  @@index([workspaceId])
  @@index([subjectType, operatorType])
}

model CollectionTask {
  id         String               @id @default(cuid())
  projectId  String
  userId     String
  status     CollectionTaskStatus @default(PENDING)
  sourceUrl  String?
  pageTitle  String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots  DataSnapshot[]
  analyses   AiAnalysisTask[]
  auditLogs  AuditLog[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model DataSnapshot {
  id                 String             @id @default(cuid())
  taskId             String
  pageType           String?
  rawDomText          String?
  rawNetworkJson      Json?
  rawTableData        Json?
  visibleMetricsJson  Json?
  screenshotUrl       String?
  localCollectedAt    DateTime
  uploadedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  task                CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  normalizedMetrics   NormalizedMetric[]

  @@index([taskId])
}

model NormalizedMetric {
  id           String       @id @default(cuid())
  snapshotId   String
  metricKey    String
  metricName   String
  metricValue  String
  metricUnit   String?
  metricSource String
  createdAt    DateTime     @default(now())
  snapshot      DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([metricKey])
}

model AiAnalysisTask {
  id               String           @id @default(cuid())
  collectionTaskId String
  provider         String
  model            String
  promptVersion    String
  status           AnalysisStatus   @default(PENDING)
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  collectionTask   CollectionTask   @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]

  @@index([collectionTaskId])
  @@index([status])
}

model Recommendation {
  id                   String         @id @default(cuid())
  aiAnalysisTaskId      String
  summary              String
  riskLevel            RiskLevel
  problemsJson         Json?
  suggestionsJson      Json?
  manualCheckItemsJson Json?
  confidence           Float
  createdAt            DateTime       @default(now())
  aiAnalysisTask        AiAnalysisTask @relation(fields: [aiAnalysisTaskId], references: [id], onDelete: Cascade)

  @@index([aiAnalysisTaskId])
  @@index([createdAt])
}

model AuditLog {
  id          String          @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  taskId      String?
  action      String
  detailJson  Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        CollectionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([action])
}
