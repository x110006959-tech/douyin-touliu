generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum BusinessType {
  DOUYIN_LOCAL_LIFE
}

enum SubjectType {
  SUBJECT_PENDING
  MERCHANT_OFFICIAL
  PROFESSIONAL
  EXTERNAL_CREATOR
  CREATOR_MATRIX
  SERVICE_PROVIDER
  PLATFORM_EVENT
  BRAND_REGION_MATRIX
}

enum OperatorType {
  OPERATOR_PENDING
  MERCHANT_SELF
  SERVICE_PROVIDER_LIVE
  SERVICE_PROVIDER_OPERATION
  CREATOR_SELF
  AGENCY_LEADER
  PLATFORM_OPERATION
  BRAND_REGION
}

enum CooperationType {
  COOPERATION_PENDING
  NONE
  PROFESSIONAL_BINDING
  CREATOR_COOPERATION
  SERVICE_PROVIDER_CONTRACT
  PLATFORM_INVITATION
  BRAND_MATRIX
}

enum ControlLevel {
  PENDING
  HIGH
  MEDIUM
  LOW
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum CollectionTaskStatus {
  PENDING
  COLLECTING
  REVIEWING
  UPLOADED
  PROCESSING
  ANALYZED
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActionType {
  OBSERVE
  INCREASE_BUDGET
  DECREASE_BUDGET
  KEEP_BUDGET
  FINE_TUNE_TARGETING
  DECREASE_BID
  PAUSE_TASK
  ADJUST_ROI_TARGET
  CHECK_LIVE_ROOM
  CHECK_CREATIVE
  CHECK_AUDIENCE
  VERIFY_ACTIVITY
  APPLY_ACTIVITY
  OPTIMIZE_SCRIPT
  REPAIR_REPUTATION
  STRENGTHEN_SHELF
  CHECK_INVENTORY_BOOKING
  OPTIMIZE_POI_SEARCH
  REPLACE_CREATOR
  UNIFY_CREATOR_SCRIPT
  ADJUST_SERVICE_PROVIDER_SOP
  RENEGOTIATE_SERVICE_FEE
  REUSE_MATERIAL
  ALLOCATE_HIGH_VERIFY_STORES
  CALIBRATE_SUBJECT
  REQUEST_MANUAL_REVIEW
}

enum ActionProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OBSERVING
  MANUAL_EXECUTED
}

enum ApprovalDecision {
  APPROVE
  REJECT
  APPROVED
  REJECTED
  OBSERVE
}

enum ExecutionMode {
  MANUAL
}

enum ExecutionStatus {
  PENDING
  MANUAL_EXECUTED
  FAILED
}

enum OutcomeObservationWindow {
  THIRTY_MINUTES
  TWO_HOURS
  ONE_DAY
  CUSTOM
}

enum ActionOutcomeResult {
  IMPROVED
  WORSENED
  NO_CHANGE
  UNCLEAR
}

enum MetricSource {
  XHR_JSON
  TABLE
  DOM_TEXT
  SCREENSHOT
  MANUAL_INPUT
  UNKNOWN
}

enum MetricReviewStatus {
  PENDING
  CONFIRMED
  MODIFIED
  IGNORED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  role            UserRole         @default(MEMBER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspaces      Workspace[]
  collectionTasks CollectionTask[]
  auditLogs       AuditLog[]
  approvalRecords ApprovalRecord[]
  executionLogs   ExecutionLog[]
  reviewedMetrics ReviewedMetric[]
  actionOutcomes  ActionOutcome[]
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects  Project[]
  auditLogs AuditLog[]

  @@index([ownerId])
}

model Project {
  id                  String          @id @default(cuid())
  workspaceId         String
  name                String
  businessType        BusinessType    @default(DOUYIN_LOCAL_LIFE)
  subjectType         SubjectType     @default(SUBJECT_PENDING)
  operatorType        OperatorType    @default(OPERATOR_PENDING)
  cooperationType     CooperationType @default(COOPERATION_PENDING)
  controlLevel        ControlLevel    @default(PENDING)
  subjectConfidence   Float           @default(0)
  serviceProviderName String?
  serviceMode         String?
  serviceFee          Float?
  status              ProjectStatus   @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  workspace           Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks               CollectionTask[]
  auditLogs           AuditLog[]
  decisionRuns        DecisionRun[]
  actionProposals     ActionProposal[]
  executionLogs       ExecutionLog[]
  strategyRules       StrategyRule[]
  actionOutcomes      ActionOutcome[]

  @@index([workspaceId])
  @@index([subjectType, operatorType])
}

model CollectionTask {
  id         String               @id @default(cuid())
  projectId  String
  userId     String
  status     CollectionTaskStatus @default(PENDING)
  sourceUrl  String?
  pageTitle  String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots  DataSnapshot[]
  analyses   AiAnalysisTask[]
  auditLogs  AuditLog[]
  decisionRuns    DecisionRun[]
  actionProposals ActionProposal[]
  executionLogs   ExecutionLog[]
  reviewedMetrics ReviewedMetric[]
  actionOutcomes  ActionOutcome[]

  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model DataSnapshot {
  id                 String             @id @default(cuid())
  taskId             String
  pageType           String?
  rawDomText          String?
  rawNetworkJson      Json?
  rawTableData        Json?
  visibleMetricsJson  Json?
  screenshotUrl       String?
  localCollectedAt    DateTime
  uploadedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  task                CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  normalizedMetrics   NormalizedMetric[]
  reviewedMetrics     ReviewedMetric[]

  @@index([taskId])
}

model NormalizedMetric {
  id           String       @id @default(cuid())
  snapshotId   String
  metricKey    String
  metricName   String
  metricValue  String
  metricUnit   String?
  metricSource String
  confidence    Float        @default(0.5)
  rawEvidence   Json?
  createdAt    DateTime     @default(now())
  snapshot      DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  reviewedMetric ReviewedMetric?

  @@index([snapshotId])
  @@index([metricKey])
}

model ReviewedMetric {
  id                 String             @id @default(cuid())
  taskId             String
  snapshotId         String?
  normalizedMetricId String?            @unique
  metricKey          String
  metricName         String
  originalValue      String?
  reviewedValue      String?
  metricUnit         String?
  metricSource       MetricSource       @default(UNKNOWN)
  confidence         Float              @default(0.5)
  rawEvidence        Json?
  pageType           String?
  scope              String?
  timeRange          String?
  reviewStatus       MetricReviewStatus @default(PENDING)
  reviewerId         String?
  reviewedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  task               CollectionTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  snapshot           DataSnapshot?      @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  normalizedMetric   NormalizedMetric?  @relation(fields: [normalizedMetricId], references: [id], onDelete: SetNull)
  reviewer           User?              @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([snapshotId])
  @@index([metricKey])
  @@index([metricSource])
  @@index([reviewStatus])
  @@index([reviewerId])
}

model AiAnalysisTask {
  id               String           @id @default(cuid())
  collectionTaskId String
  provider         String
  model            String
  promptVersion    String
  status           AnalysisStatus   @default(PENDING)
  requestPayload   Json?
  responsePayload  Json?
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  collectionTask   CollectionTask   @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]
  decisionRuns     DecisionRun[]

  @@index([collectionTaskId])
  @@index([status])
}

model Recommendation {
  id                   String         @id @default(cuid())
  aiAnalysisTaskId      String
  summary              String
  riskLevel            RiskLevel
  problemsJson         Json?
  suggestionsJson      Json?
  manualCheckItemsJson Json?
  confidence           Float
  createdAt            DateTime       @default(now())
  aiAnalysisTask        AiAnalysisTask @relation(fields: [aiAnalysisTaskId], references: [id], onDelete: Cascade)

  @@index([aiAnalysisTaskId])
  @@index([createdAt])
}

model DecisionRun {
  id                 String           @id @default(cuid())
  projectId          String
  collectionTaskId   String
  aiAnalysisTaskId   String?
  engineVersion      String
  ruleVersion        String
  strategyVersion    String           @default("local-life-rules-v0.1.0")
  inputJson          Json?
  riskLevel          RiskLevel
  confidence         Float
  diagnosis          String
  ruleResultJson     Json
  aiResultJson       Json?
  finalResultJson    Json
  manualCheckItemsJson Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask     CollectionTask   @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  aiAnalysisTask     AiAnalysisTask?  @relation(fields: [aiAnalysisTaskId], references: [id], onDelete: SetNull)
  actionProposals    ActionProposal[]

  @@index([projectId])
  @@index([collectionTaskId])
  @@index([aiAnalysisTaskId])
  @@index([createdAt])
}

model ActionProposal {
  id               String               @id @default(cuid())
  decisionRunId    String
  projectId        String
  collectionTaskId String
  actionType       ActionType
  title            String
  summary          String?
  reason           String
  expectedImpact   String?
  riskLevel        RiskLevel
  confidence       Float
  requiresApproval Boolean              @default(true)
  blockedReason    String?
  status           ActionProposalStatus @default(PENDING_APPROVAL)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  approvedAt       DateTime?
  rejectedAt       DateTime?
  observedAt       DateTime?
  manualExecutedAt DateTime?
  decisionRun      DecisionRun          @relation(fields: [decisionRunId], references: [id], onDelete: Cascade)
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask   CollectionTask       @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  approvalRecords  ApprovalRecord[]
  executionLogs    ExecutionLog[]
  outcomes         ActionOutcome[]

  @@index([decisionRunId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([status])
  @@index([actionType])
}

model ApprovalRecord {
  id               String           @id @default(cuid())
  actionProposalId String
  userId           String
  decision         ApprovalDecision
  comment          String?
  createdAt        DateTime         @default(now())
  actionProposal   ActionProposal   @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionProposalId])
  @@index([userId])
  @@index([decision])
}

model ExecutionLog {
  id               String           @id @default(cuid())
  actionProposalId String
  projectId        String?
  collectionTaskId String?
  userId           String
  mode             ExecutionMode    @default(MANUAL)
  status           ExecutionStatus  @default(MANUAL_EXECUTED)
  note             String?
  createdAt        DateTime         @default(now())
  actionProposal   ActionProposal   @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  collectionTask   CollectionTask?  @relation(fields: [collectionTaskId], references: [id], onDelete: SetNull)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionProposalId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([userId])
  @@index([status])
}

model ActionOutcome {
  id                String                   @id @default(cuid())
  actionProposalId  String
  projectId         String
  collectionTaskId  String
  userId            String
  observationWindow OutcomeObservationWindow
  customWindow      String?
  beforeMetricsJson Json?
  afterMetricsJson  Json?
  result            ActionOutcomeResult
  note              String?
  conclusion        String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  actionProposal    ActionProposal           @relation(fields: [actionProposalId], references: [id], onDelete: Cascade)
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collectionTask    CollectionTask           @relation(fields: [collectionTaskId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([actionProposalId])
  @@index([projectId])
  @@index([collectionTaskId])
  @@index([userId])
  @@index([result])
  @@index([createdAt])
}

model StrategyRule {
  id            String       @id @default(cuid())
  projectId     String?
  name          String
  description   String?
  subjectType   SubjectType?
  actionType    ActionType?
  enabled       Boolean      @default(true)
  priority      Int          @default(100)
  conditionJson Json
  effectJson    Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([subjectType])
  @@index([actionType])
  @@index([enabled])
}

model AuditLog {
  id          String          @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  taskId      String?
  action      String
  detailJson  Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task        CollectionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([taskId])
  @@index([action])
}
