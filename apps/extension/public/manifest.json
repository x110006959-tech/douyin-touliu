{
  "manifest_version": 3,
  "name": "Douyin Local Life Diagnosis Collector",
  "version": "0.1.0",
  "description": "Collects visible page data and allowed JSON responses for diagnosis.",
  "permissions": ["activeTab", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.douyin.com/*",
    "https://*.douyinlife.com/*",
    "https://*.juliangengine.com/*",
    "https://*.oceanengine.com/*",
    "https://*.bytedance.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Douyin Diagnosis Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.douyin.com/*",
        "https://*.douyinlife.com/*",
        "https://*.juliangengine.com/*",
        "https://*.oceanengine.com/*",
        "https://*.bytedance.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://*.douyin.com/*",
        "https://*.douyinlife.com/*",
        "https://*.juliangengine.com/*",
        "https://*.oceanengine.com/*",
        "https://*.bytedance.com/*"
      ]
    }
  ]
}
