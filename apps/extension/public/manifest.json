{
  "manifest_version": 3,
  "name": "PXXIS 智能投流采集",
  "version": "0.0.0",
  "description": "仅采集已打开的授权页面可见数据，不拦截平台网络请求。",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://eos.douyin.com/*",
    "https://localads.chengzijianzhan.cn/*",
    "https://api.pxxis.cn/*",
    "https://www.pxxis.cn/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Douyin Diagnosis Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eos.douyin.com/*",
        "https://localads.chengzijianzhan.cn/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pxxis.cn/*"
      ],
      "js": ["web-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
