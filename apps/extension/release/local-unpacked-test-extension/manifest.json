{
  "manifest_version": 3,
  "name": "PXXIS 智能投流采集（本地测试）",
  "version": "0.2.4",
  "description": "本地测试包：只用于本机开发验收，不得上传 Chrome 网上应用店。",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://eos.douyin.com/*",
    "https://localads.chengzijianzhan.cn/*",
    "https://api.pxxis.cn/*",
    "https://www.pxxis.cn/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PXXIS 智能投流采集（本地测试）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://eos.douyin.com/*",
        "https://localads.chengzijianzhan.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.pxxis.cn/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
