{
  "name": "@douyin-local-life/api",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @douyin-local-life/shared --filter @douyin-local-life/llm --filter @douyin-local-life/decision-engine --filter @douyin-local-life/diagnosis-skills build && tsx watch src/index.ts",
    "build": "node ../../tools/clean-dist.mjs dist && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/decision-worker-main.js",
    "worker": "tsx src/decision-worker-main.ts",
    "diagnosis:eval:fake": "tsx src/diagnosis-eval-cli.ts",
    "diagnosis:eval:live": "tsx src/diagnosis-eval-cli.ts --live",
    "diagnosis:eval:eligible": "tsx src/diagnosis-eval-cli.ts --live --include-eligible",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "retention:dry-run": "tsx src/retention-cli.ts --dry-run",
    "retention:run": "tsx src/retention-cli.ts --run",
    "capture:repair:dry-run": "tsx src/capture-derived-data-repair-cli.ts",
    "capture:repair:run": "tsx src/capture-derived-data-repair-cli.ts --run",
    "retention:schedule": "node dist/retention-scheduler.js"
  },
  "dependencies": {
    "@douyin-local-life/decision-engine": "workspace:*",
    "@douyin-local-life/diagnosis-skills": "workspace:*",
    "@douyin-local-life/llm": "workspace:*",
    "@douyin-local-life/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "helmet": "8.1.0",
    "nodemailer": "9.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "7.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
