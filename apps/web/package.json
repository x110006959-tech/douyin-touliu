{
  "name": "@douyin-local-life/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "corepack pnpm --filter @douyin-local-life/shared build && next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
